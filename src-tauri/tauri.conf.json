{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FRIDAY",
  "version": "0.1.0",
  "identifier": "com.friday.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FRIDAY",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Your personal AI assistant",
    "longDescription": "A local-first, user-owned personal AI desktop assistant.",
    "resources": [
      "worker/friday-worker.exe"
    ]
  }
}
